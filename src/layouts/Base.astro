---
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} | ${site.role}`,
  description = 'Technical artist and pipeline engineer building generative AI workflows, animation tools and production pipelines. Previously DreamWorks Animation and Uthana.',
} = Astro.props;

const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <nav class="container nav" aria-label="Main">
        <a href="/" class="logo">
          {site.logo && <img src={site.logo} alt="" width="32" height="32" class="logo-img" />}
          <span>{site.name}</span>
        </a>
        <div class="links">
          <a href="/#work">Work</a>
          <a href="/#reel">Reel</a>
          <a href="/#about">About</a>
          <a href="/#contact">Contact</a>
          <a href={site.resume} class="resume">Resume</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer id="contact" class="site-footer">
      <div class="container footer-inner">
        <h2 class="cta">Let's build something.</h2>
        <div class="btn-row">
          <a class="btn btn-primary" href={`mailto:${site.email}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><polyline points="3 7 12 13 21 7"></polyline></svg>
            {site.email}
          </a>
          <a class="btn" href={site.linkedin}>LinkedIn</a>
          {site.github && <a class="btn" href={site.github}>GitHub</a>}
          <a class="btn" href={site.resume}>Resume (PDF)</a>
        </div>
        <div class="legal">
          <span>© {year} {site.name}</span>
          <span>{site.role}</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--border); }
  .nav {
    padding-block: 20px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;
  }
  .logo { font-family: var(--font-display); font-weight: 700; font-size: 20px; letter-spacing: -0.01em;
    display: inline-flex; align-items: center; gap: 10px; }
  .logo-img { width: 32px; height: 32px; object-fit: contain; border-radius: 6px; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 28px; font-size: 15px; }
  .resume { padding: 10px 18px; border: 1px solid var(--accent); border-radius: 8px; color: var(--accent); font-weight: 500; }
  .resume:hover { background: var(--accent); color: var(--accent-ink); }

  .site-footer { border-top: 1px solid var(--border); }
  .footer-inner { padding-block: 96px 56px; display: flex; flex-direction: column; gap: 40px; }
  .cta { font-size: clamp(40px, 5vw, 56px); line-height: 1.05; letter-spacing: -0.025em; }
  .legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px;
    padding-top: 32px; border-top: 1px solid var(--border);
    font-size: 14px; color: var(--text-faint);
  }

  @media (max-width: 640px) {
    .links { gap: 18px; }
  }
</style>
